// use prisma-8

model Profile{
  profileId           Uuid      @id @unique @default(uuid())
  name                String
  profileDescription  String
  createdAt           DateTime 
}

model Resource{
  resourceId          Uuid      @id @unique @default(uuid())
  profileId           Uuid
  resourceName        String
  resourceUrl         String
  createdAt           DateTime
}

model Skill{
  skillId             Uuid      @id @unique 
}